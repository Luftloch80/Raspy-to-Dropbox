# Copy to config.env and adjust for your Pi:
#   cp config.example.env config.env

# Directory for temporary (or kept) image files
BACKUP_DIR=/var/tmp/raspi-backup

# rclone remote name from `rclone config` (Dropbox)
DROPBOX_REMOTE=dropbox

# Folder inside Dropbox (created automatically on upload).
# Hostname keeps multiple Pis from sharing one folder.
DROPBOX_PATH=/RaspiBackups/$(hostname -s)

# Keep the local .img after upload? 0=delete, 1=keep
KEEP_LOCAL=0

# How many remote backups to retain (0 = never delete)
KEEP_REMOTE=3

# Compression: gzip | pigz | xz | zstd | none
# pigz is faster on multi-core Pis; install with: sudo apt install pigz
COMPRESS=pigz

# dd block size
DD_BS=4M

# Leave empty to auto-detect the disk that holds /
# Examples: /dev/mmcblk0  /dev/nvme0n1  /dev/sda
SOURCE_DEVICE=

# Optional log file (empty = stdout only)
LOG_FILE=/var/log/raspi-dropbox-backup.log

# Set to 1 to print actions without imaging/uploading
DRY_RUN=0

# Set to 1 to create the image but skip Dropbox upload
SKIP_UPLOAD=0
